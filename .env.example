# Public/non-sensitive settings only. Real local .env files are ignored.
APP_ORIGIN=http://localhost:8080
TRUST_PROXY_HOPS=0
# Optional deployment-managed email configuration (prefer a mounted API-key file).
# RESEND_API_KEY_FILE=/run/secrets/resend-api-key
# EMAIL_FROM=secrets@example.com

# Optional deployment-only restriction. Blank allows any valid email domain.
ALLOWED_EMAIL_DOMAINS=
PUBLIC_OPERATOR_NAME=
# Example: ALLOWED_EMAIL_DOMAINS=example.com
# Example: PUBLIC_OPERATOR_NAME=Example Team
